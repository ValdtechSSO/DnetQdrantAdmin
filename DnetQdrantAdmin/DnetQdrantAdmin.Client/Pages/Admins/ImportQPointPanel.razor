@using Dnet.QdrantAdmin.Application.Shared.Dtos
@using Dnet.QdrantAdmin.Client.Pages.Admin
@using Dnet.Blazor.Components.Button
@using Dnet.Blazor.Components.Checkbox
@using Dnet.Blazor.Components.Dialog.Infrastructure.Interfaces
@using Dnet.Blazor.Components.Dialog.Infrastructure.Models
@using Dnet.Blazor.Components.FloatingPanel.Infrastructure.Enums
@using Dnet.Blazor.Components.FloatingPanel.Infrastructure.Interfaces
@using Dnet.Blazor.Components.FloatingPanel.Infrastructure.Models
@using Dnet.Blazor.Components.Form
@using Dnet.Blazor.Components.Grid.BlgGrid;
@using Dnet.Blazor.Components.Grid.Infrastructure.Entities;
@using Dnet.Blazor.Components.Overlay.Infrastructure.Enums
@using Dnet.Blazor.Components.Overlay.Infrastructure.Models
@using Dnet.Blazor.Components.Overlay.Infrastructure.Services
@using Dnet.Blazor.Components.Toast.Infrastructure.Enums
@using Dnet.Blazor.Components.Toast.Infrastructure.Interfaces
@using Dnet.Blazor.Components.Toast.Infrastructure.Models
@using Dnet.Blazor.Components.Select
@using System.Net.Http.Headers;
@using System.Text.Json

@inject IFloatingPanelService FloatingPanelService
@inject IToastService ToastService
@inject IDialogService DialogService
@inject IAdminService AdminService

<div class="dnet-panel in-floating-panel">
    <div class="dnet-panel-header">
        <div class="dsec-panel-content">
            <span class="dsec-panel-content-title">Import resources</span>
        </div>
    </div>
    <div class="dnet-panel-content">
        <EditForm EditContext="@_editContext">
            <div style="display:flex; align-items: baseline">
                <label for="file-upload" class="custom-file-upload">
                    Import file
                </label>
                <span class="dnet-m-l-10">@_fileName</span>
                <InputFile OnChange="@ReadFile" id="file-upload" class="dnet-m-b-20 dnet-m-t-10" style="display: none;" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <DnetFormField Label="File format" UseClearButton="false">
                    <ChildContent>
                        <DnetSelect TValue="string"
                                    @bind-Value="_fileFormat"
                                    Items="_fileFormats"
                                    TItem="string"
                                    DisplayValueConverter="(value) => (value)"
                                    ValueConverter="(value) => (value)"
                                    PlaceHolder="Format"
                                    OnItemSelected="RefreshPreview">
                        </DnetSelect>
                    </ChildContent>
                </DnetFormField>
                @if (_fileFormat != "Jsonl")
                {
                    <div style="display: flex; align-items: center; margin-top: 10px;">
                        <DnetInputCheckbox @bind-Value="_hasHeader" @bind-Value:after="RefreshPreview" DisplayName="File has header">
                            File has header
                        </DnetInputCheckbox>
                    </div>
                }
            </div>

            @if (_preview.Headers.Any())
            {
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                    <DnetFormField Label="Text column" UseClearButton="false" IsRequired="true">
                        <ChildContent>
                            <DnetSelect TValue="string"
                                        @bind-Value="_textField"
                                        Items="_preview.Headers"
                                        TItem="string"
                                        DisplayValueConverter="(value) => (value)"
                                        ValueConverter="(value) => (value)"
                                        PlaceHolder="Text column"
                                        OnItemSelected="RefreshPreview">
                            </DnetSelect>
                        </ChildContent>
                        <HintContent>
                            Column embedded as the point text
                        </HintContent>
                    </DnetFormField>
                </div>
                <div style="font-size: .75rem; color: #6c757d; margin: 4px 0;">Payload columns (none selected = all except text)</div>
                <div style="max-height: 130px; overflow-y: auto; border: 1px solid #e2e2e2; border-radius: 4px; padding: 6px 10px; display: flex; flex-wrap: wrap; gap: 6px 14px;">
                    @foreach (var header in _preview.Headers.Where(h => h != _textField))
                    {
                        <DnetInputCheckbox @bind-Value="_payloadFieldStates[header]" @bind-Value:after="(() => PayloadFieldChanged(header))" DisplayName="@header">
                            @header
                        </DnetInputCheckbox>
                    }
                </div>
            }

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px;">
                <DnetFormField Label="LLM Model" IsRequired="true">
                    <ChildContent>
                        <DnetSelect TValue="string"
                                    @bind-Value="_modelDto.Model"
                                    Items="_llmModels"
                                    TItem="ModelDto"
                                    DisplayValueConverter="DisplayModel"
                                    ValueConverter="(value) => (value.Model)"
                                    PlaceHolder=""
                                    OnItemSelected="ModelSelected">
                        </DnetSelect>
                    </ChildContent>
                    <ErrorContent>
                        <ValidationMessage For="@(() => _modelDto.Model)" />
                    </ErrorContent>
                </DnetFormField>
                <DnetFormField Label="Dimension" IsRequired="true">
                    <ChildContent>
                        <DnetSelect TValue="int"
                                    @bind-Value="_modelDto.Dimension"
                                    Items="_dimensions"
                                    TItem="int"
                                    DisplayValueConverter="(value) => (value.ToString())"
                                    ValueConverter="(value) => (value)"
                                    PlaceHolder=""
                                    >
                        </DnetSelect>
                    </ChildContent>
                    <ErrorContent>
                        <ValidationMessage For="@(() => _modelDto.Dimension)" />
                    </ErrorContent>
                </DnetFormField>
            </div>
            <DataAnnotationsValidator />
        </EditForm>
        <div style="height: calc(100% - 300px); margin-top: 10px;">
            <BlgGrid @ref="@_qpointBlGridReference"
                     GridData="@_qpoints"
                     GridColumns="@_qpointGridColumns"
                     GroupGridColumn="GetGroupGridColumn<QpointDto>()"
                     TItem="QpointDto"
                     GridOptions="@_qpointGridOptions">
            </BlgGrid>
        </div>
        <div style="margin-top: 10px;">
            @if (_preview.Points.Any())
            {
                <span style="font-size: .8rem;">@_preview.Points.Count rows ready to import</span>
                @if (_preview.SkippedCount > 0)
                {
                    <span style="font-size: .8rem; color: #d9534f;"> · @_preview.SkippedCount rows skipped</span>
                }
            }
            @if (_preview.Errors.Any())
            {
                <div style="margin-top: 8px; max-height: 120px; overflow-y: auto; border: 1px solid #e2e2e2; padding: 8px; background: #fff8f8;">
                    @foreach (var error in _preview.Errors)
                    {
                        <div style="font-size: .75rem; color: #d9534f;">@error</div>
                    }
                </div>
            }
        </div>
    </div>
    <div class="dnet-panel-footer">
        <DnetButton OnClick="CancelOverlay" class="dnet-m-r-10">Close</DnetButton>
        <DnetButton OnClick="CloseOverlay" InitialFocus="true" class="dnet-m-r-10" disabled="@_formInvalid">Ok</DnetButton>
    </div>
</div>

@code {
    [CascadingParameter]
    public Error? Error { get; set; }

    [CascadingParameter]
    private int OverlayReferenceId { get; set; }

    [Parameter]
    public List<ModelDto> Models { get; set; } = new();

    private const long MaxFileSize = 1024 * 1024 * 15;

    private BlgGrid<QpointDto> _qpointBlGridReference = default!;

    private List<QpointDto> _qpoints { get; set; } = new();

    private ImportPreviewDto _preview { get; set; } = new();

    private List<GridColumn<QpointDto>> _qpointGridColumns { get; set; } = default!;

    private GridOptions<QpointDto> _qpointGridOptions { get; set; } = default!;

    private bool _formInvalid = true;

    private EditContext? _editContext { get; set; }

    private ValidationMessageStore? messageStore { get; set; }

    private List<ModelDto> _llmModels { get; set; } = new();

    private List<int> _dimensions { get; set; } = new();

    private ModelDto _modelDto { get; set; } = new();

    private string _fileName { get; set; } = string.Empty;

    private byte[] _fileBytes { get; set; } = [];

    private string _fileFormat { get; set; } = "Csv";

    private string _textField { get; set; } = string.Empty;

    private bool _hasHeader { get; set; } = true;

    private List<string> _fileFormats { get; set; } = new() { "Csv", "Tsv", "Jsonl" };

    private Dictionary<string, bool> _payloadFieldStates { get; set; } = new();

    private List<string> _payloadFields { get; set; } = new();


    protected override void OnInitialized()
    {
        _qpointGridOptions = QpointGridConfiguration.GetQpointGridOptions();

        _qpointGridOptions.CheckboxSelectionColumn = false;

        _qpointGridColumns = QpointGridConfiguration.GetImportQpointGridColumns();

        _llmModels = Models;

        if (_llmModels.Any())
        {
            var model = _llmModels.FirstOrDefault(p => p.Default) ?? _llmModels.First();

            _modelDto.Model = model.Model;

            _modelDto.ProviderName = model.ProviderName;

            _dimensions = model.Dimensions;

            _modelDto.Dimension = model.Dimensions.FirstOrDefault();
        }

        _editContext = new EditContext(_modelDto);

        messageStore = new(_editContext);

        _editContext.OnFieldChanged += (data, eventArgs) =>
        {
            StateHasChanged();
        };

        _editContext.OnValidationRequested += (data, eventArgs) =>
        {
            messageStore?.Clear();

            StateHasChanged();
        };
    }

    private GridColumn<T> GetGroupGridColumn<T>()
    {
        return new GridColumn<T>
            {
                Height = 40,
                Width = 200,
                CanGrow = 0
            };
    }

    private void CloseOverlay()
    {
        if (_formInvalid || !_qpoints.Any()) return;

        var createPointsDto = new CreatePointsDto()
            {
                pointDtos = _preview.Points,
                LlmModel = _modelDto.Model,
                ProviderName = _modelDto.ProviderName,
                Dimension = _modelDto.Dimension
            };

        var dataResult = new OverlayResult()
            {
                CloseReason = CloseReason.Ok,
                ComponentData = createPointsDto,
                OverlayReferenceId = OverlayReferenceId,
            };

        FloatingPanelService.Close(dataResult);
    }

    private void CancelOverlay()
    {
        var dataResult = new OverlayResult()
            {
                CloseReason = CloseReason.Cancel,
                ComponentData = null,
                OverlayReferenceId = OverlayReferenceId
            };

        FloatingPanelService.Close(dataResult);
    }

    private async Task ReadFile(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file is null) return;

        try
        {
            if (file.Size > MaxFileSize)
            {
                Error?.ProcessError(new InvalidOperationException($"The file exceeds the maximum allowed size of {MaxFileSize / (1024 * 1024)} MB."));

                return;
            }

            await using var stream = file.OpenReadStream(MaxFileSize);

            using var memory = new MemoryStream();

            await stream.CopyToAsync(memory);

            _fileBytes = memory.ToArray();

            _fileName = file.Name;

            _fileFormat = DetectFormat(file.Name);

            _textField = string.Empty;

            _payloadFieldStates.Clear();

            _payloadFields.Clear();

            await RefreshPreview();
        }
        catch (Exception ex)
        {
            _formInvalid = true;

            Error?.ProcessError(ex);
        }
    }

    private static string DetectFormat(string fileName)
    {
        var extension = Path.GetExtension(fileName).ToLowerInvariant();

        return extension switch
        {
            ".tsv" or ".tab" => "Tsv",
            ".jsonl" or ".ndjson" => "Jsonl",
            _ => "Csv"
        };
    }

    private async Task RefreshPreview()
    {
        if (_fileBytes.Length == 0) return;

        try
        {
            var form = new MultipartFormDataContent();

            var fileContent = new ByteArrayContent(_fileBytes);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue("application/octet-stream");
            form.Add(fileContent, "files", _fileName);

            var config = new ImportConfigDto
                {
                    FileFormat = _fileFormat,
                    TextField = _textField,
                    PayloadFields = _payloadFields,
                    HasHeader = _hasHeader
                };

            form.Add(new StringContent(JsonSerializer.Serialize(config)), "config");

            _preview = await AdminService.GetImportQPointData(form);

            _qpoints = _preview.Points;

            if (string.IsNullOrEmpty(_textField) && _preview.Headers.Any())
            {
                _textField = _preview.Headers.First();
            }

            // Reset payload checkbox states for the current headers.
            foreach (var header in _preview.Headers)
            {
                if (!_payloadFieldStates.ContainsKey(header))
                {
                    _payloadFieldStates[header] = _payloadFields.Contains(header);
                }
            }

            _formInvalid = !_editContext.Validate();

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _formInvalid = true;

            Error?.ProcessError(ex);
        }
    }

    private async Task PayloadFieldChanged(string header)
    {
        if (_payloadFieldStates.TryGetValue(header, out var selected) && selected && !_payloadFields.Contains(header))
        {
            _payloadFields.Add(header);
        }
        else
        {
            _payloadFields.Remove(header);
        }

        await RefreshPreview();
    }

    private static string DisplayModel(ModelDto value)
    {
        return string.IsNullOrEmpty(value.ProviderName) ? value.Model : $"{value.ProviderName} · {value.Model}";
    }

    private void ModelSelected()
    {
        var model = _llmModels.FirstOrDefault(p => p.Model == _modelDto.Model);

        _dimensions = model?.Dimensions ?? new();

        _modelDto.ProviderName = model?.ProviderName ?? string.Empty;
    }
}
